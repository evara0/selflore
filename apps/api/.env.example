# Local development only. Password is stored separately by start-local.cmd -Configure.
SELFLORE_ENV=dev
SELFLORE_DATABASE_URL="host=127.0.0.1 port=6171 dbname=selflore_dev user=selflore_dev_app"
PGPASSFILE=../../.cache/local/pgpass.conf
# Registration is enabled by default. Use false here only to explicitly close it.
SELFLORE_ALLOW_REGISTRATION=true

# Explicitly initialize these private directories before enabling uploads.
# SELFLORE_MEDIA_ROOT=G:/selflore-data/media
# SELFLORE_MEDIA_OPS_ROOT=G:/selflore-data/media-ops
